    "auth.error.cannot_interact_blocks_items_before_login": "\u00a7c\u0414\u043e \u0432\u0445\u043e\u0434\u0430 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0441 \u0431\u043b\u043e\u043a\u0430\u043c\u0438 \u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c\u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u043e.",
    "auth.error.cannot_drop_before_login": "\u00a7c\u0414\u043e \u0432\u0445\u043e\u0434\u0430 \u0432\u044b\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0442\u044c \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u043d\u0435\u043b\u044c\u0437\u044f.",
    "auth.error.cannot_open_containers_before_login": "\u00a7c\u0414\u043e \u0432\u0445\u043e\u0434\u0430 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u044b \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u043d\u0435\u043b\u044c\u0437\u044f.",
